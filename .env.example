# ── client, inlined into the PUBLIC bundle at build time ──────────────────
# Vite inlines these when the bundle is built, so changing them on the host
# needs a REDEPLOY, not a refresh. Missing the Supabase pair no longer blanks
# the site, but the work will not load. See src/lib/supabase.ts.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Cloudinary uploads are UNSIGNED, so only the cloud name is needed and no
# secret reaches the client. Without this the admin falls back to uploading
# into Supabase storage.
VITE_CLOUDINARY_CLOUD_NAME=<cloud name>
# Optional. Defaults to ml_default, which is shared with the sibling projects.
# Point this at a preset locked to the bigyems-portfolio folder to tighten it.
# VITE_CLOUDINARY_UPLOAD_PRESET=<preset name>

# ── server only, for api/sign-upload.ts ───────────────────────────────────
# UNUSED while uploads are unsigned. The endpoint is kept for the day a
# Cloudinary key with `create` permission exists; setting these two switches
# nothing on by itself. NEVER prefix them with VITE_.
# CLOUDINARY_API_KEY=<api key>
# CLOUDINARY_API_SECRET=<api secret>
